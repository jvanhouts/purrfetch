{
  "name": "purrfetch",
  "version": "0.1.0",
  "description": "A neofetch-style system readout, rendered in your browser instead of the terminal.",
  "keywords": [
    "neofetch",
    "fetch",
    "system-info",
    "cli",
    "sysinfo",
    "screenshot"
  ],
  "license": "MIT",
  "author": "Jess van Houts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jvanhouts/purrfetch.git"
  },
  "homepage": "https://purrfetch.jess0x.dev",
  "bugs": "https://github.com/jvanhouts/purrfetch/issues",
  "type": "module",
  "bin": {
    "purrfetch": "bin/purrfetch.js"
  },
  "files": [
    "bin"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "npm run typecheck && vite build && npm run build:cli",
    "build:cli": "bun build cli/index.ts --target=node --outfile bin/purrfetch.js",
    "serve": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p cli --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build:cli",
    "deploy": "npm run build && bunx gh-pages@6.3.0 --dist dist --branch gh-pages --dotfiles --message \"deploy from $(git rev-parse --short HEAD)\""
  },
  "devDependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@paper-design/shaders-react": "^0.0.80",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^24",
    "@types/react": "~19.2.17",
    "@types/react-dom": "~19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "html-to-image": "^1.11.13",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^8"
  }
}
